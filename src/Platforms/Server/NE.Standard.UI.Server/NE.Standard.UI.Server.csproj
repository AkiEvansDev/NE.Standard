<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>NE.Standard.UI.Server</PackageId>
    <Description>The headless ASP.NET Core server host of the NE.Standard UI framework: serves compiled view descriptors, the SignalR live channel, and file transfer over HTTP for remote NE.Standard.UI.Client and WPF clients without HTML shell rendering.</Description>
    <PackageTags>NE.Standard,UI,Platform,Server</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Web\NE.Standard.UI.Web\NE.Standard.UI.Web.csproj" />
    <!-- Analyzers pass through to the application, so the engine's generator reaches a project that installs only this host. -->
    <ProjectReference Include="..\..\..\Core\NE.Standard.UI\NE.Standard.UI.csproj" PrivateAssets="contentfiles;build" />
    <ProjectReference Include="..\..\..\Core\NE.Standard.UI.Components\NE.Standard.UI.Components.csproj" />
    <ProjectReference Include="..\..\..\Generators\NE.Standard.UI.Generators\NE.Standard.UI.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

</Project>
