<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>NE.Standard.UI.Web</PackageId>
    <Description>The ASP.NET Core host of the NE.Standard UI framework: the shell, the SignalR live channel, file transfer over HTTP, and the TypeScript client, which ships embedded in the assembly — there is no separate front-end deploy step.</Description>
    <PackageTags>NE.Standard,UI,Platform,Web</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NE.Benchmarks.Standard.UI.Web</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NE.Test.Standard.UI.Web</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NE.Standard.UI.Web.Abstractions\NE.Standard.UI.Web.Abstractions.csproj" />
    <!-- Analyzers pass through to the application, so the engine's generator reaches a project that installs only this host. -->
    <ProjectReference Include="..\..\..\Core\NE.Standard.UI\NE.Standard.UI.csproj" PrivateAssets="contentfiles;build" />
    <ProjectReference Include="..\..\..\Core\NE.Standard.UI.Components\NE.Standard.UI.Components.csproj" />
    <ProjectReference Include="..\..\..\Generators\NE.Standard.UI.Generators\NE.Standard.UI.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Client\dist\ui.css" />
    <None Remove="Client\dist\ui.js" />
    <None Remove="Client\dist\ui-boot.js" />
    <Content Remove="Client\dist\ui.css" />
    <Content Remove="Client\dist\ui.js" />
    <Content Remove="Client\dist\ui-boot.js" />
    <None Remove="Client\dist\ui-worker.js" />
    <Content Remove="Client\dist\ui-worker.js" />
  </ItemGroup>

  <PropertyGroup>
    <WebClientDist>$(MSBuildProjectDirectory)\Client\dist</WebClientDist>
    <WebClientCss>$(WebClientDist)\ui.css</WebClientCss>
    <WebClientJs>$(WebClientDist)\ui.js</WebClientJs>
    <WebClientBoot>$(WebClientDist)\ui-boot.js</WebClientBoot>
    <WebClientWorker>$(WebClientDist)\ui-worker.js</WebClientWorker>
  </PropertyGroup>

  <!-- The client builds as part of dotnet build (WebClient.targets, imported from Directory.Build.targets). -->
  <PropertyGroup>
    <BuildsWebClient>true</BuildsWebClient>
  </PropertyGroup>

  <ItemGroup>
    <WebClientOutput Include="$(WebClientCss)" />
    <WebClientOutput Include="$(WebClientJs)" />
    <WebClientOutput Include="$(WebClientBoot)" />
    <WebClientOutput Include="$(WebClientWorker)" />
  </ItemGroup>

  <!-- OFL 1.1 asks that the licence travel with the font, so it does. -->
  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="Client\fonts\LICENSE-geist.txt" Pack="true" PackagePath="\LICENSE-geist.txt" />
    <None Include="Client\fonts\LICENSE-material-symbols.txt" Pack="true" PackagePath="\LICENSE-material-symbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(WebClientCss)" LogicalName="NE.Standard.UI.Web.Client.dist.ui.css" />
    <EmbeddedResource Include="$(WebClientJs)" LogicalName="NE.Standard.UI.Web.Client.dist.ui.js" />
    <EmbeddedResource Include="$(WebClientBoot)" LogicalName="NE.Standard.UI.Web.Client.dist.ui-boot.js" />
    <EmbeddedResource Include="$(WebClientWorker)" LogicalName="NE.Standard.UI.Web.Client.dist.ui-worker.js" />
    <EmbeddedResource Include="Client\fonts\GeistVariable.woff2" LogicalName="NE.Standard.UI.Web.Client.fonts.GeistVariable.woff2" />
    <EmbeddedResource Include="Client\fonts\NEGlyphs.woff2" LogicalName="NE.Standard.UI.Web.Client.fonts.NEGlyphs.woff2" />
  </ItemGroup>

</Project>
