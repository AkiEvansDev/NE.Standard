<Project>

  <!-- The namespaces of this package an application writes against. The .targets beside this file turns them into global
       usings unless the project sets NEStandardUIImplicitUsings to false; a package only names its own. -->
  <ItemGroup>
    <NEStandardUIUsing Include="NE.Standard.UI.Primitives.Annotations" />
    <NEStandardUIUsing Include="NE.Standard.UI.Primitives.Binding" />
    <NEStandardUIUsing Include="NE.Standard.UI.Primitives.Constants" />
    <NEStandardUIUsing Include="NE.Standard.UI.Primitives.Interaction" />
    <NEStandardUIUsing Include="NE.Standard.UI.Primitives.Items" />
    <NEStandardUIUsing Include="NE.Standard.UI.Primitives.Localization" />
    <NEStandardUIUsing Include="NE.Standard.UI.Primitives.Security" />
    <NEStandardUIUsing Include="NE.Standard.UI.Primitives.Styling" />
    <NEStandardUIUsing Include="NE.Standard.UI.Primitives.Text" />
  </ItemGroup>

</Project>
