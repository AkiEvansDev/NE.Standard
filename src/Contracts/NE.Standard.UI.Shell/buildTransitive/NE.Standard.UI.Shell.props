<Project>

  <!-- The namespaces of this package an application writes against. The .targets beside this file turns them into global
       usings unless the project sets NEStandardUIImplicitUsings to false; a package only names its own. -->
  <ItemGroup>
    <NEStandardUIUsing Include="NE.Standard.UI.Shell.Commands" />
    <NEStandardUIUsing Include="NE.Standard.UI.Shell.Files" />
    <NEStandardUIUsing Include="NE.Standard.UI.Shell.Navigation" />
    <NEStandardUIUsing Include="NE.Standard.UI.Shell.Runtime" />
    <NEStandardUIUsing Include="NE.Standard.UI.Shell.Sessions" />
  </ItemGroup>

</Project>
