<Project>

  <!-- The namespaces of this package an application writes against. The .targets beside this file turns them into global
       usings unless the project sets NEStandardUIImplicitUsings to false; a package only names its own. -->
  <ItemGroup>
    <NEStandardUIUsing Include="NE.Standard.UI.Abstractions.Binding" />
    <NEStandardUIUsing Include="NE.Standard.UI.Abstractions.Data" />
    <NEStandardUIUsing Include="NE.Standard.UI.Abstractions.Effects" />
    <NEStandardUIUsing Include="NE.Standard.UI.Abstractions.Interaction" />
    <NEStandardUIUsing Include="NE.Standard.UI.Abstractions.Items" />
    <NEStandardUIUsing Include="NE.Standard.UI.Abstractions.Navigation" />
    <NEStandardUIUsing Include="NE.Standard.UI.Abstractions.Recursive" />
    <NEStandardUIUsing Include="NE.Standard.UI.Abstractions.Styling" />
  </ItemGroup>

</Project>
