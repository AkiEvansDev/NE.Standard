<Project>

  <!-- The namespaces of this package an application writes against. The .targets beside this file turns them into global
       usings unless the project sets NEStandardUIImplicitUsings to false; a package only names its own. -->
  <ItemGroup>
    <NEStandardUIUsing Include="NE.Standard.UI.Authoring.BuiltIns" />
    <NEStandardUIUsing Include="NE.Standard.UI.Authoring.Components" />
    <NEStandardUIUsing Include="NE.Standard.UI.Authoring.Views" />
  </ItemGroup>

</Project>
