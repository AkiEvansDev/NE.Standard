<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>NE.Standard.UI.Extensions</PackageId>
    <Description>Presets over the NE.Standard UI components: shorthands for the component arrangements an application writes again and again: text, pages, inline messages, layouts, buttons, forms and details.</Description>
    <PackageTags>NE.Standard,UI,Extensions,Presets</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The presets are shorthands over the built-in components, so the built-ins are all this package needs. -->
    <ProjectReference Include="..\..\Core\NE.Standard.UI.Components\NE.Standard.UI.Components.csproj" />
  </ItemGroup>

</Project>
