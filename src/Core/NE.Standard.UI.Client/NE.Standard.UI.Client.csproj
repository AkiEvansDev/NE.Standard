<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>NE.Standard.UI.Client</PackageId>
    <Description>The C# client engine of the NE.Standard UI framework: holds a page's state, applies server change sets and effects, runs client interactions, validation rules, item filters and sorts, and drives the host through a transport seam.</Description>
    <PackageTags>NE.Standard,UI,Client</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NE.Standard.UI.Testing</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NE.Test.Standard.UI</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NE.Standard.UI\NE.Standard.UI.csproj" />
  </ItemGroup>

</Project>
