<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>NE.Standard.UI</PackageId>
    <Description>The engine of the NE.Standard UI framework: it compiles a view and a controller into an immutable indexed description once, then keeps the rendered surface and the controller's object graph in sync both ways. Hosting, routing, sessions and scheduling included.</Description>
    <PackageTags>NE.Standard,UI,Core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NE.Test.Standard.UI</_Parameter1>
    </AssemblyAttribute>
    <!-- One slice, released together: the web platform shares the application's temp folder derivation (UIApplicationStorage). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NE.Standard.UI.Web</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NE.Benchmarks.Standard.UI</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- A package dependency whose analyzers reach whoever installs the engine, so an application needs no generator package
         of its own. A reference output is what makes pack write the dependency; compile and runtime are excluded so nothing
         downstream compiles against the generator and the Roslyn it brings - only its analyzer part is meant to travel. -->
    <ProjectReference Include="..\..\Generators\NE.Standard.UI.Generators\NE.Standard.UI.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" ExcludeAssets="compile;runtime" PrivateAssets="contentfiles;build" />
    <ProjectReference Include="..\..\Contracts\NE.Standard.UI.Primitives\NE.Standard.UI.Primitives.csproj" />
    <ProjectReference Include="..\..\Contracts\NE.Standard.UI.Abstractions\NE.Standard.UI.Abstractions.csproj" />
    <ProjectReference Include="..\..\Contracts\NE.Standard.UI.Authoring\NE.Standard.UI.Authoring.csproj" />
    <ProjectReference Include="..\..\Contracts\NE.Standard.UI.Compiled\NE.Standard.UI.Compiled.csproj" />
    <ProjectReference Include="..\..\Contracts\NE.Standard.UI.Shell\NE.Standard.UI.Shell.csproj" />
    <ProjectReference Include="..\NE.Standard.UI.Components\NE.Standard.UI.Components.csproj" />
  </ItemGroup>

</Project>
