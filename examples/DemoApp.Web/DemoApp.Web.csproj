<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DemoApp\DemoApp.csproj" />
  </ItemGroup>

  <!-- See DemoApp.csproj: sources in the monorepo, packages in a mirror. -->
  <ItemGroup Condition="'$(InMonorepo)' == 'true'">
    <ProjectReference Include="..\..\src\Platforms\Web\NE.Standard.UI.Web\NE.Standard.UI.Web.csproj" />
    <ProjectReference Include="..\..\src\Platforms\Web\NE.Standard.UI.Web.Renderers\NE.Standard.UI.Web.Renderers.csproj" />
    <ProjectReference Include="..\..\addons\Icons\src\NE.Standard.UI.Web.Icons.Lucide\NE.Standard.UI.Web.Icons.Lucide.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(InMonorepo)' != 'true'">
    <PackageReference Include="NE.Standard.UI.Web" Version="$(CoreVersion)" />
    <PackageReference Include="NE.Standard.UI.Web.Renderers" Version="$(CoreVersion)" />
    <PackageReference Include="NE.Standard.UI.Web.Icons.Lucide" Version="$(IconsVersion)" />
  </ItemGroup>

</Project>
