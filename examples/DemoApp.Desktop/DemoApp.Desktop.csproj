<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DemoApp\DemoApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\DemoApp.Web\DemoAppWebServices.cs" Link="DemoAppWebServices.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\DemoApp.Web\wwwroot\**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- See DemoApp.csproj: sources in the monorepo, packages in a mirror. -->
  <ItemGroup Condition="'$(InMonorepo)' == 'true'">
    <ProjectReference Include="..\..\src\Platforms\Desktop\NE.Standard.UI.Desktop\NE.Standard.UI.Desktop.csproj" />
    <ProjectReference Include="..\..\src\Platforms\Web\NE.Standard.UI.Web.Renderers\NE.Standard.UI.Web.Renderers.csproj" />
    <ProjectReference Include="..\..\addons\Icons\src\NE.Standard.UI.Web.Icons.Material\NE.Standard.UI.Web.Icons.Material.csproj" />
    <ProjectReference Include="..\..\addons\CodeInput\src\NE.Standard.UI.Web.CodeInput\NE.Standard.UI.Web.CodeInput.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(InMonorepo)' != 'true'">
    <PackageReference Include="NE.Standard.UI.Desktop" Version="$(CoreVersion)" />
    <PackageReference Include="NE.Standard.UI.Web.Renderers" Version="$(CoreVersion)" />
    <PackageReference Include="NE.Standard.UI.Web.Icons.Material" Version="$(IconsVersion)" />
    <PackageReference Include="NE.Standard.UI.Web.CodeInput" Version="$(CodeInputVersion)" />
  </ItemGroup>

</Project>
